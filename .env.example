# Copy to .env for local development. Never commit a real key.

# Local default is file-backed SQLite. On Railway this is set to the Postgres URL.
DATABASE_URL=sqlite+aiosqlite:///./sales_agent.db

# Required for /chat. The app boots without it (so /health and /catalog work),
# but any LLM-backed call returns a 503 Problem Details until it is set.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Models (override only if you want different cost/quality trade-offs).
AGENT_MODEL=claude-sonnet-4-6
EVAL_MODEL=claude-haiku-4-5
SUMMARIZER_MODEL=claude-haiku-4-5

# Eval flagging threshold (0.0–1.0).
FLAG_CONFIDENCE_THRESHOLD=0.7

LOG_LEVEL=INFO
