# Copy to .env and fill in. For local dev only ANTHROPIC_API_KEY is required.
#   cp .env.example .env

# --- LLM ---
# Your Anthropic key. The app still boots without it (health + catalog work), but
# /chat then fails fast with a 503.
ANTHROPIC_API_KEY=

# --- security ---
# Shared secret for /chat and /reviews, sent by clients as the `X-API-Key` header.
# Leave empty locally to run keyless. REQUIRED in production — the app refuses to
# boot when ENVIRONMENT=production and this is unset.
API_KEY=

# Requests per minute per caller (keyed by API key, else IP). 0 disables.
RATE_LIMIT_PER_MINUTE=60

# --- environment ---
# "development" locally. Set to "production" on your host (e.g. Railway) to turn the
# convenient-but-unsafe local defaults (open API, SQLite) into hard boot-time errors.
ENVIRONMENT=development

# --- persistence ---
# Local default is file-backed SQLite. In production set a Postgres URL (Railway's
# Postgres plugin injects DATABASE_URL automatically when attached).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- logging ---
LOG_LEVEL=INFO
